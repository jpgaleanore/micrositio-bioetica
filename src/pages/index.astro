---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Presentacion from '../components/Presentacion.astro';
import Analisis from '../components/Analisis.astro';
import Entrevista from '../components/Entrevista.astro';
import Deliberacion from '../components/Deliberacion.astro';
import Conclusiones from '../components/Conclusiones.astro';
import Referencias from '../components/Referencias.astro';
---

<BaseLayout
  title="IA en el diagnóstico médico | Micrositio bioético"
  description="Micrositio académico sobre el dilema bioético de la inteligencia artificial en el diagnóstico médico: presentación, análisis interdisciplinario, entrevista, deliberación ética, conclusiones y referencias APA."
>
  <Hero />
  <Presentacion />
  <Analisis />
  <Entrevista />
  <Deliberacion />
  <Conclusiones />
  <Referencias />
</BaseLayout>
